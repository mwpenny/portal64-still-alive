\(
    +clone

    \( -clone 0 -brightness-contrast -2x10 -crop 10x32+219+29 -rotate 90 -repage +0+0 \)
    \( -clone 0 -brightness-contrast -2x10 -crop 10x32+219+50 -rotate 90 -repage +0+8 \)

    -layers merge
